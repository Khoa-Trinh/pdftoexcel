{
  "name": "invoice-extractor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite build && wrangler dev --config wrangler.jsonc",
    "deploy": "vite build && wrangler deploy --config wrangler.jsonc",
    "deploy:dry-run": "vite build && wrangler deploy --config wrangler.jsonc --dry-run",
    "cf:typegen": "wrangler types worker-configuration.d.ts --config wrangler.jsonc",
    "test": "node --test tests/*.test.ts",
    "parse:invoice": "node scripts/parse-invoice.ts",
    "verify:production": "wrangler deploy --config wrangler.jsonc --dry-run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "lucide-react": "1.55.0",
    "pdf-parse": "2.4.5",
    "pdfjs-dist": "5.4.296",
    "radix-ui": "1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.4",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "nitro": "3.0.260903-beta",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  }
}
